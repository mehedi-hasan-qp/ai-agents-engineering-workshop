# OpenAI-compatible endpoint. Any provider that speaks the /chat/completions
# wire format works here - Groq, OpenAI, OpenRouter, Together, a local Ollama, etc.

# Free, no credit card: create a key at https://console.groq.com/keys
LLM_API_KEY=

# Groq's OpenAI-compatible base URL. Swap this to point at any other provider.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Must support tool/function calling. llama-3.3-70b-versatile is Groq's current default.
LLM_MODEL=llama-3.3-70b-versatile
