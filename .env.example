# OpenAI-compatible endpoint. Any provider that speaks the /chat/completions
# wire format works here - Groq, OpenAI, OpenRouter, Gemini, a local Ollama, etc.
# Model must support tool/function calling.

# --- Groq (recommended: free, no credit card, fast) ---
# Create a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- Google Gemini (free tier, via its OpenAI-compatible endpoint) ---
# Create a key at https://aistudio.google.com/apikey
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash-lite
